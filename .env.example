# Backend จริงของโปรเจกต์
VITE_API_BASE_URL=https://hardware-store-search-backend.onrender.com

# false = ใช้ Backend/Google OAuth จริง
VITE_USE_MOCK_AUTH=false

# Google OAuth Web Client ID (ใส่ค่าจริงใน .env หรือ Vercel Environment Variables)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# ใช้เฉพาะตอนเปิด Mock
VITE_MOCK_ROLE=USER
