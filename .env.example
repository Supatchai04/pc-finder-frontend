# true = ใช้ Mock โดยไม่ต้องมี Backend/Google Client ID
VITE_USE_MOCK_AUTH=true

# ใช้เมื่อ VITE_USE_MOCK_AUTH=false
VITE_API_BASE_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# ใช้สำหรับทดสอบ Mock เท่านั้น: USER | SHOP | ADMIN
VITE_MOCK_ROLE=SHOP
